<?xml version="1.0" encoding="UTF-8"?>

<templates xml:space="preserve">

    <t t-name="quick_note.GlobalQuickNote">

        <div
            t-if="state.isOpen"
            class="quick-note-overlay"
        >

            <div class="quick-note-popup">

                <!-- Header -->
                <div class="quick-note-header">

                    <div class="quick-note-header-title">
                        <i class="fa fa-sticky-note-o"/>
                        <h3>Quick Note</h3>
                    </div>

                    <button
                        type="button"
                        class="btn-close"
                        t-on-click="closePopup"
                        aria-label="Close"
                    />

                </div>

                <!-- Body -->
                <div class="quick-note-body">

                    <!-- Title -->
                    <div class="mb-3">

                        <label class="form-label">
                            Title
                        </label>

                        <input
                            type="text"
                            class="form-control"
                            placeholder="Enter note title..."
                            t-on-input="onTitleInput"
                            t-att-value="state.title"
                            autofocus="autofocus"
                        />

                    </div>

                    <!-- Customer + Category side by side -->
                    <div class="mb-3 quick-note-row">

                        <div class="quick-note-col">
                            <label class="form-label">
                                Customer
                            </label>

                            <select
                                class="form-select"
                                t-on-change="onPartnerChange"
                            >

                                <option value="">
                                    Select Customer
                                </option>

                                <t t-foreach="partners" t-as="partner" t-key="partner.id">

                                    <option
                                        t-att-value="partner.id"
                                    >
                                        <t t-esc="partner.name"/>
                                    </option>

                                </t>

                            </select>
                        </div>

                        <div class="quick-note-col">
                            <label class="form-label">
                                Category
                            </label>

                            <select
                                class="form-select"
                                t-on-change="onCategoryChange"
                            >

                                <option value="">
                                    Select Category
                                </option>

                                <t
                                    t-foreach="categories"
                                    t-as="category"
                                    t-key="category.id"
                                >

                                    <option
                                        t-att-value="category.id"
                                    >
                                        <t t-esc="category.name"/>
                                    </option>

                                </t>

                            </select>
                        </div>

                    </div>

                    <!-- Priority -->
                    <div class="mb-3">
                        <label class="form-label">
                            Priority
                        </label>
                        <div class="quick-note-priority-group">

                            <button
                                type="button"
                                t-att-class="'priority-pill priority-normal' + (state.priority === '0' ? ' active' : '')"
                                t-on-click="() => this.onPrioritySelect('0')"
                            >
                                <span class="priority-dot"/>
                                Normal
                            </button>

                            <button
                                type="button"
                                t-att-class="'priority-pill priority-important' + (state.priority === '1' ? ' active' : '')"
                                t-on-click="() => this.onPrioritySelect('1')"
                            >
                                <span class="priority-dot"/>
                                Important
                            </button>

                            <button
                                type="button"
                                t-att-class="'priority-pill priority-urgent' + (state.priority === '2' ? ' active' : '')"
                                t-on-click="() => this.onPrioritySelect('2')"
                            >
                                <span class="priority-dot"/>
                                Urgent
                            </button>

                        </div>

                    </div>

                    <!-- Description -->
                    <div class="mb-3">

                        <label class="form-label">
                            Description
                        </label>

                        <textarea
                            class="form-control quick-note-textarea"
                            rows="5"
                            placeholder="Write your note..."
                            t-on-input="onDescriptionInput"
                        ><t t-esc="state.description"/></textarea>

                    </div>

                </div>

                <!-- Footer -->
                <div class="quick-note-footer">

                    <button
                        type="button"
                        class="btn btn-secondary"
                        t-on-click="closePopup"
                    >
                        Cancel
                    </button>

                    <button
                        type="button"
                        class="btn btn-primary"
                        t-on-click="saveNote"
                    >
                        <i class="fa fa-check me-1"/>
                        Save Note
                    </button>

                </div>

            </div>

        </div>

    </t>

</templates>